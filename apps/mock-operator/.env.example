# Port the mock operator's lobby + wallet both listen on.
MOCK_OPERATOR_PORT=4300

# Operator identity — must match the row created by the rgs-server `seed` script.
# Pinned dev UUID so both sides resolve to the same tenant.
MOCK_OPERATOR_ID=00000000-0000-4000-8000-000000000001

# Inbound credentials — mock operator → RGS session create (POST /v1/session).
# The RGS seed installs the matching kid + secret as an INBOUND credential.
MOCK_OPERATOR_API_KEY_ID=kid_mock_dev
MOCK_OPERATOR_API_SECRET=mock-dev-shared-secret

# Outbound wallet HMAC secret — used by the RGS to sign calls TO our /wallet/*
# endpoints. The RGS seed installs this as the OUTBOUND wallet secret for this
# operator; we verify inbound HMAC using the same shared secret.
MOCK_OPERATOR_WALLET_SECRET=mock-dev-wallet-secret

# Where the RGS is listening (for POST /v1/session).
RGS_BASE_URL=http://localhost:4500

# Where the game iframe lives — informational only; the RGS decides the real
# launchUrl, we just echo it for lobby display.
GAME_CLIENT_BASE_URL=http://localhost:3100

# Clock-skew tolerance when verifying inbound HMAC from the RGS (seconds).
SIGNATURE_WINDOW_SECONDS=30

# Requested player launch-session lifetime. The RGS caps this server-side.
MOCK_OPERATOR_SESSION_TTL_SECONDS=14400

# Seeded player refs + their starting balance in micro-units (LKR 10,000).
# Intentionally hard-coded in src/wallet/store.ts — this env var is just a hint.
# 1_000_000_000 micro = 10,000.00 LKR.
