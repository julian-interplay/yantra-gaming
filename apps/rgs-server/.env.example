# Postgres — self-hosted; avoid clashing with B2C repo (which uses 5433).
DATABASE_URL=postgresql://yantra_gaming:yantra_gaming_dev@localhost:5434/yantra_gaming

# HMAC-signed short-lived session tokens (player scope).
SESSION_JWT_SECRET=dev-change-me-session-jwt-secret

# Master key for AES-GCM encryption of OperatorCredential.cipherBlob.
# 32 raw bytes, base64-encoded. Prod value comes from a KMS.
SECRETS_MASTER_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# HTTP + Socket.IO port.
PORT=4500

# Comma-separated list of allowed CORS origins (game-client, operator-portal, mock-operator).
CORS_ORIGIN=http://localhost:3100,http://localhost:3101,http://localhost:3102

# Replay protection window for inbound signed HMAC requests (seconds).
SIGNATURE_WINDOW_SECONDS=30

# Base URL of the game-client iframe app, used when returning launchUrl.
GAME_CLIENT_BASE_URL=http://localhost:3100

# Outbound wallet HTTP call timeout (milliseconds).
WALLET_CALL_TIMEOUT_MS=5000

# Seeded mock operator wallet callback base. Required when running seed with NODE_ENV=production.
MOCK_WALLET_CALLBACK_URL=http://localhost:4300/wallet

# Admin portal JWT (separate from player session JWT).
PORTAL_JWT_SECRET=dev-change-me-portal-jwt-secret

NODE_ENV=development
